document.getElementById("generate").addEventListener("click", () => {
  const input = document.getElementById("input").value.trim();
  const output = document.getElementById("output");

  if (!input) {
    output.innerHTML = "Please describe your product first.";
    return;
  }

  // Simulated AI response (you can later connect to an API)
  const message = `Introducing ${input}! Experience innovation powered by AI — designed to simplify your workflow and boost productivity.`;

  output.innerHTML = message;
});
